# Copy to .env and adjust. Every value below is optional; the defaults shown are
# what the service uses when the variable is absent.

# --- inference -------------------------------------------------------------
AUTOMASK_DEVICE=auto              # auto | cuda | cpu
AUTOMASK_PRIMARY_MODEL=birefnet   # birefnet | u2net | grabcut
AUTOMASK_BIREFNET_REPO=ZhengPeng7/BiRefNet   # ...BiRefNet_lite is ~3x faster
AUTOMASK_INFER_SIZE=1024          # network input; 768 trades ~1.5 IoU pts for ~40% speed
AUTOMASK_FP16=1                   # half precision on CUDA
AUTOMASK_MAX_SIDE=6000            # reject larger uploads outright

# --- quality control -------------------------------------------------------
AUTOMASK_ENSEMBLE=1               # run U2-Net as an independent cross-check
AUTOMASK_READY_THRESHOLD=0.82     # confidence needed to auto-publish
AUTOMASK_REVIEW_THRESHOLD=0.55    # below this the mask is rejected outright

# --- refinement ------------------------------------------------------------
AUTOMASK_REFINE_EDGES=1           # guided-filter matting in the trimap band
AUTOMASK_SUPPRESS_STRANDS=1       # cut hair strands out of garment masks
AUTOMASK_TRIMAP_BAND=9
AUTOMASK_GUIDED_RADIUS=8
AUTOMASK_GUIDED_EPS=0.0001

# --- extra layers ----------------------------------------------------------
AUTOMASK_SHADOW_MAPS=1
AUTOMASK_DISPLACEMENT=1
AUTOMASK_PRINT_AREA=1

# --- optional models -------------------------------------------------------
AUTOMASK_CLIP=0                   # CLIP zero-shot category detection (MIT)
AUTOMASK_SAM_REFINE=0             # MobileSAM refiner - AGPL-3.0 loader, read the notes

# --- service ---------------------------------------------------------------
AUTOMASK_BATCH_WORKERS=2
AUTOMASK_MAX_UPLOAD_MB=40
AUTOMASK_FETCH_TIMEOUT=30
AUTOMASK_RETENTION_HOURS=72       # job folders older than this are purged at boot
AUTOMASK_OUTPUT_DIR=./outputs
# AUTOMASK_API_KEY=change-me      # when set, all /v1 endpoints require X-API-Key
